# Public URL of the deployed site (metadata and Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` locally, or the webhook endpoint in the dashboard in production
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring monthly Price (Product catalog → price ID). Unset → an inline price is used (dev only)
STRIPE_PRICE_MONTHLY_PACK=price_...     # $29 / month

# Paid-only links (server-side, never sent to the browser before payment)
DISCORD_URL=
# One Google Drive folder per pack, plus one for the four-pack bundle
DRIVE_URL_GOLDEN_HOUR=
DRIVE_URL_MIDNIGHT_CITY=
DRIVE_URL_COASTAL_DRIVE=
DRIVE_URL_FOREST_TRAIL=
DRIVE_URL_BUNDLE=

# Emails subscribers the packs not shown on /access (https://resend.com). Unset → logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=FanpageKit <packs@yourdomain.com>

# Onboarding booking embed on /access
NEXT_PUBLIC_CALENDLY_URL=
